   "id": "31220c51-8c46-4dbe-845c-041247c8a54e",
   "name": "Respuesta automática",
   "type": "n8n-nodes-base.set",
   "typeVersion": 3.4,
   "position": [
    2240,
    140
   ]
  },
  {
   "parameters": {
    "assignments": {
     "assignments": [
      {
       "id": "de1f3d0f-7fdc-42c4-b836-73fc6a0f62d5",
       "name": "derivar_a_humano",
       "value": "true",
       "type": "boolean"
      },
      {
