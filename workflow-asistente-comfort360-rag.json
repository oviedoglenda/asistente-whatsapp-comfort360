  {
   "parameters": {
    "jsCode": "// Simula mensajes de WhatsApp (mismo formato que envía WhatsApp Business)\nreturn [\n  { json: { from: '5491100000001', text: { body: \"Hola, buenas tardes. ¿Cuánto sale el kit de bandas?\" } } },\n  { json: { from: '5491100000001', text: { body: \"Tengo 70 años y nunca hice ejercicio, ¿con cuántas bandas empiezo?\" } } },\n  { json: { from: '5491100000001', text: { body: \"¿Cómo se hace el puente de glúteos?\" } } },\n  { json: { from: '5491100000002', text: { body: \"Me operaron de la rodilla hace un mes, ¿puedo hacer los ejercicios?\" } } },\n  { json: { from: '5491100000002', text: { body: \"Quiero comprar el kit, ¿cuánto sale el envío a Mendoza?\" } } },\n  { json: { from: '5491100000003', text: { body: \"   \" } } }\n];"
