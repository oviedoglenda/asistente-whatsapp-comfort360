   "position": [
    1080,
    240
   ],
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "model": "nomic-embed-text:latest"
   },
   "id": "d8d3e160-aff5-4556-909e-5daa3be90bb4",
   "name": "Embeddings Ollama (búsqueda)",
   "type": "@n8n/n8n-nodes-langchain.embeddingsOllama",
   "typeVersion": 1,
   "position": [
    1080,
    440
   ]
  },
  {
   "parameters": {
    "jsCode": "// Junta los fragmentos recuperados del Vector Store y arma el mensaje para el agente\nconst msg = $('Recorrer mensajes').first().json;\nconst docs = $input.all().map(i => i.json.document?.pageContent).filter(Boolean);\nconst contexto = docs.length ? docs.join('\\n---\\n') : '(sin información encontrada en la base de conocimiento)';\nreturn [{ json: { telefono: msg.telefono, mensaje: msg.mensaje, fragmentos: docs.length,\n  prompt: `CONTEXTO (base de conocimiento de Comfort 360):\\n${contexto}\\n\\nMENSAJE DEL CLIENTE:\\n${msg.mensaje}` } }];"
   },
   "id": "b39e9d06-229e-428f-9ac3-221c3333e6a0",
   "name": "Armar contexto",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1300,
    240
   ]
  },
  {
   "parameters": {
    "promptType": "define",
    "text": "={{ $json.prompt }}",
    "options": {
     "systemMessage": "ROL\nSos el asistente de WhatsApp de Comfort 360, un emprendimiento que vende el kit de bandas elásticas CENIBA (5 bandas + guía de 11 ejercicios sin impacto), pensado sobre todo para personas mayores.\n\nCÓMO RESPONDÉS\n- Usá SOLO la información de la sección CONTEXTO que viene en cada mensaje. Si la respuesta no está ahí, no la inventes: derivá.\n- Tono cálido, paciente y respetuoso, con palabras simples. Tratá de \"vos\"; si el cliente escribe de \"usted\", respondé de \"usted\".\n- Mensajes cortos, como en WhatsApp: máximo 4 líneas, sin listas largas ni asteriscos. Como mucho un emoji.\n\nQUÉ PODÉS HACER\n- Responder dudas sobre el kit, el precio, las bandas, los ejercicios de la guía, el plan de 8 semanas y el Reto CENIBA.\n- Explicar cómo se hace un ejercicio de la guía, tal como figura en el contexto.\n\nLÍMITES (QUÉ NO PODÉS HACER)\n- No sos médico ni kinesiólogo: no diagnostiques ni indiques tratamientos, ni prometas resultados.\n- No inventes precios, costos de envío, descuentos, stock ni plazos.\n- No tomes pedidos ni pagos, y no pidas datos de tarjetas, documentos ni datos de salud.\n\nCUÁNDO DERIVAR A UNA PERSONA (accion = \"derivar\")\n- La persona quiere comprar, pregunta el costo de envío a su provincia, o pregunta por cuotas o descuentos.\n- Menciona dolor, una lesión, una operación o una enfermedad: respondé con amabilidad que consulte a su médico o kinesiólogo antes de empezar, y derivá.\n- Tiene un reclamo, pide hablar con alguien, o el mensaje es ambiguo o no está cubierto por el CONTEXTO.\nEn esos casos, en \"respuesta\" decile que una persona del equipo de Comfort 360 le va a responder por este mismo WhatsApp.\n\nFORMATO DE SALIDA\nRespondé SOLO con un JSON válido, sin texto antes ni después:\n{\"accion\": \"responder\" o \"derivar\", \"categoria\": \"producto\" | \"ejercicios\" | \"compra\" | \"salud\" | \"reclamo\" | \"otro\", \"respuesta\": \"el mensaje para el cliente\"}"
    }
   },
   "id": "d2e76eb0-f6f7-48bb-8c81-b86c4a581cca",
   "name": "AI Agent",
   "type": "@n8n/n8n-nodes-langchain.agent",
   "typeVersion": 1.7,
   "position": [
    1500,
    240
   ],
   "onError": "continueRegularOutput"
  },
  {
   "parameters": {
    "model": "llama3.2:3b",
    "options": {
     "temperature": 0.2
    }
   },
   "id": "637bec52-1b71-495d-9d96-4b4ec5320fba",
   "name": "Ollama Chat Model",
   "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
   "typeVersion": 1,
   "position": [
    1460,
    460
   ]
  },
  {
   "parameters": {
    "sessionIdType": "customKey",
    "sessionKey": "={{ $json.telefono }}",
    "contextWindowLength": 6
   },
   "id": "2848b338-fb6d-4c71-9325-2366683cb361",
   "name": "Memoria (por teléfono)",
   "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
   "typeVersion": 1.3,
   "position": [
    1620,
    460
   ]
  },
  {
   "parameters": {
    "jsCode": "// Valida la respuesta del agente. Si viene vacía, con error o sin el formato pedido, se deriva a una persona.\nconst ctx = $('Armar contexto').first().json;\nconst raw = $json.output ?? '';\nlet r = null;\ntry { const m = String(raw).match(/\\{[\\s\\S]*\\}/); r = m ? JSON.parse(m[0]) : null; } catch (e) { r = null; }\nconst valido = r && ['responder', 'derivar'].includes(String(r.accion).toLowerCase()) && String(r.respuesta || '').trim();\nif (!valido) {\n  return [{ json: { telefono: ctx.telefono, mensaje: ctx.mensaje, accion: 'derivar', categoria: 'error_ia',\n    respuesta: 'Gracias por escribirnos. En un ratito te responde una persona del equipo de Comfort 360 por este mismo WhatsApp.',\n    error_ia: $json.error ? String($json.error.message || $json.error) : 'Respuesta vacía o fuera de formato' } }];\n}\nlet accion = String(r.accion).toLowerCase();\nif (ctx.fragmentos === 0) accion = 'derivar';   // sin contexto recuperado, no se responde solo\nreturn [{ json: { telefono: ctx.telefono, mensaje: ctx.mensaje, accion, categoria: r.categoria || 'otro',\n  respuesta: String(r.respuesta).trim(), error_ia: '' } }];"
   },
   "id": "81b8acfd-bb3a-48ff-b192-c65e86150d5c",
   "name": "Validar respuesta de la IA",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1820,
    240
   ]
  },
  {
   "parameters": {
    "rules": {
     "values": [
      {
       "conditions": {
        "options": {
         "caseSensitive": true,
         "leftValue": "",
         "typeValidation": "strict",
         "version": 2
        },
        "conditions": [
         {
          "id": "c453f724-34b1-4f08-8595-9bdf5b2f6f3d",
          "leftValue": "={{ $json.accion }}",
          "rightValue": "responder",
          "operator": {
           "type": "string",
           "operation": "equals"
          }
         }
        ],
        "combinator": "and"
       },
       "renameOutput": true,
       "outputKey": "Responder"
      },
      {
       "conditions": {
        "options": {
         "caseSensitive": true,
         "leftValue": "",
         "typeValidation": "strict",
         "version": 2
        },
        "conditions": [
         {
          "id": "3effb86c-318d-4c65-952d-941191209f84",
          "leftValue": "={{ $json.accion }}",
          "rightValue": "derivar",
