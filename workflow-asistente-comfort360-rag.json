   "id": "1fcfad8e-b619-4b3d-93b8-d65fd9c73c58",
   "name": "Leer planilla (Google Sheets)",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    400,
    -300
   ]
  },
  {
   "parameters": {
    "jsCode": "// Convierte la planilla (CSV) en un texto por fila para indexar en el Vector Store\nconst status = $json.statusCode ?? 200;\nconst csv = (typeof $json.data === 'string' ? $json.data : (typeof $json.body === 'string' ? $json.body : '')) || '';\nif (status !== 200 || !csv.trim()) {\n  return [{ json: { ok: false, statusCode: status, motivo: 'La planilla no respondió o vino vacía' } }];\n}\nfunction parseCSV(t) {\n  const rows = []; let row = [], f = '', q = false;\n  for (let i = 0; i < t.length; i++) {\n    const c = t[i];\n    if (q) { if (c === '\"' && t[i+1] === '\"') { f += '\"'; i++; } else if (c === '\"') q = false; else f += c; }\n    else if (c === '\"') q = true;\n    else if (c === ',') { row.push(f); f = ''; }\n    else if (c === '\\n' || c === '\\r') { if (c === '\\r' && t[i+1] === '\\n') i++; row.push(f); rows.push(row); row = []; f = ''; }\n    else f += c;\n  }\n  if (f || row.length) { row.push(f); rows.push(row); }\n  return rows.filter(r => r.some(x => x.trim()));\n}\nconst [head, ...rows] = parseCSV(csv);\nconst ix = n => head.findIndex(h => h.trim().toLowerCase() === n);\nconst iT = ix('tema'), iP = ix('pregunta'), iR = ix('respuesta');\nif (iP < 0 || iR < 0) return [{ json: { ok: false, statusCode: status, motivo: 'La planilla no tiene las columnas pregunta y respuesta' } }];\nreturn rows.map(r => ({ json: { ok: true, tema: r[iT] || '', texto: `Tema: ${r[iT] || ''}\\nPregunta: ${r[iP]}\\nRespuesta: ${r[iR]}` } }));"
   },
   "id": "70d97e7b-29f0-486a-8435-347e01011c58",
   "name": "Convertir filas en textos",
